# =========================================================
#  musa.studio · Variables de entorno (se cargan en Vercel)
# =========================================================

# --- Kie.ai (motor de imágenes) ---
# Clave de API de Kie. Se crea en https://kie.ai/api-key
KIE_API_KEY=tu-clave-de-kie

# --- Contraseña única para entrar a la app ---
# Elegí una contraseña. Es la que vas a usar para entrar.
APP_PASSWORD=una-contraseña-secreta

# --- Supabase (base + almacenamiento de imágenes) ---
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave "service_role" (SOLO servidor). La app la usa para guardar imágenes.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
